  "name": "Rustling Spots",
  "description": "Rustling Spots adds configurable rustling encounters with loot and Pokemon rewards.",
  "authors": [
    "OurStory x LevelsFR"
  ],
  "license": "MPL-2.0",
  "icon": "assets/rustlingspots/icon.png",
  "environment": "*",
  "entrypoints": {
